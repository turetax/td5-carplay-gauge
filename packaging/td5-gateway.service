[Unit]
Description=TD5 Gauge diagnostic gateway (read-only)
# The gateway only needs the local serial adapter and loopback API. Waiting for
# DHCP/Wi-Fi here needlessly delays ECU data during boot.
After=local-fs.target

[Service]
Type=simple
User=__TD5_USER__
Group=__TD5_USER__
EnvironmentFile=-/etc/td5-gauge.conf
ExecStart=__TD5_HOME__/td5gauge/pi-start-gateway.sh
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=__TD5_HOME__/td5gauge __TD5_HOME__/.local/share/td5gauge

[Install]
WantedBy=multi-user.target
