# Local Td5 Gauge configuration. Keep this file on the Pi; do not commit it.
# Leave blank to automatically prefer /dev/serial/by-id, then /dev/ttyUSB0.
TD5_SERIAL_PORT=

# Established default for the supplied K+DCAN setup. `send-break` is an
# experimental FTDI/Linux alternative and must be tested with the specific car.
TD5_FAST_INIT_MODE=break-condition
